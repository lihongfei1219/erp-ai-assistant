# Copy to .env. Never commit .env. System environment overrides this file.
# Relative paths are resolved from the project root. Values are literal, no ${...} expansion.
ERP_HOST='127.0.0.1'
ERP_PORT='8001'
ERP_REPORT_PATH='.local/reports/platform-four-domain-20260922.json'
ERP_ANALYSIS_ENGINE='langgraph'

ERP_AI_ENABLED='true'
ERP_AI_BASE_URL='https://your-model-provider.example/v1'
ERP_AI_MODEL='your-model-name'
ERP_AI_API_KEY=''

FEISHU_APP_ID=''
FEISHU_APP_SECRET=''
FEISHU_TENANT_KEY=''
# Comma-separated IDs, not JSON arrays. Empty scope never grants access.
FEISHU_ALLOWED_CHAT_IDS=''
FEISHU_USER_ACCESS_MODE='allowlist'
FEISHU_ALLOWED_USER_OPEN_IDS=''

# Optional daily webhook, separate from the application bot.
FEISHU_WEBHOOK_URL=''
FEISHU_WEBHOOK_SECRET=''

# Server examples: replace server/user/password. Source DB remains read-only.
ERP_SOURCE_ODBC='DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:db.example,1433;DATABASE=ERP_Local;UID=erp_reader;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no'
ERP_ASSISTANT_ODBC='DRIVER={ODBC Driver 18 for SQL Server};SERVER=tcp:db.example,1433;DATABASE=ERP_AI_Assistant;UID=assistant_user;PWD=replace-me;Encrypt=yes;TrustServerCertificate=no'
# Only used by the explicit init_assistant_db.py command; use a provisioning account.
ERP_ASSISTANT_ADMIN_ODBC=''

# 64 hexadecimal characters (32 random bytes). Preserve this value when migrating.
ERP_CONTEXT_SIGNING_KEY=''
ERP_GRAPH_STATE_DIR='.local/langgraph'
ERP_FEISHU_STATE_DIR='.local/feishu-app'
ERP_FEISHU_DELIVERY_DIR='.local/feishu-delivery'
ERP_SERVICES_LOCK='.local/services.lock'
