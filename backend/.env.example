# Documentation only; .env is not loaded automatically. Set process environment variables.
# Local development uses Windows authentication and shared memory.
ERP_SOURCE_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=lpc:.\ERPLOCAL;DATABASE=ERP_Local;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
# After generating a report, select its path explicitly.
ERP_REPORT_PATH=
# Generate a random development access token; never commit the real value.
ERP_API_TOKEN=

# Reserved for future Feishu application integration; not read by the app yet.
# SDK dependencies are installed, but scheduled delivery is not implemented.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
