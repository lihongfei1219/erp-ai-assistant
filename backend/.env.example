# Documentation only; .env is not loaded automatically. Set process environment variables.
# Local development uses Windows authentication and shared memory.
ERP_SOURCE_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=lpc:.\ERPLOCAL;DATABASE=ERP_Local;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
# After generating a report, select its path explicitly.
ERP_REPORT_PATH=
# Generate a random development access token; never commit the real value.
ERP_API_TOKEN=

# Group webhook; alternatively use .local/feishu-webhook.txt and feishu-secret.txt.
# Read by API and workers.feishu_daily; never returned to the browser.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Application bot connection; alternatively fill .local/feishu-app.json.
# Used by workers.feishu_bot; separate from the daily webhook sender.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional assistant task storage; must target ERP_AI_Assistant, never ERP_Local.
# ERP_ASSISTANT_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=lpc:.\ERPLOCAL;DATABASE=ERP_AI_Assistant;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes

# Model interpreter only: reads these keys from ROOT .env or process environment.
# This backend/.env.example is not itself loaded. Never put keys in frontend VITE variables.
# ERP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ERP_AI_MODEL=your-verified-model
# ERP_AI_API_KEY=fill-locally-only
# ERP_AI_ENABLED=true
# Existing root MAIN_VITE_PI_NORMALIZER_BASE_URL / _MODEL and DASHSCOPE_API_KEY
# are fallback aliases. Only question/date/schema are sent; sales results stay local.
# Web analytics also sends the previous typed plan (tool enums/dates/limits) for follow-up.
# It does not send previous question text, order evidence or calculated results.
